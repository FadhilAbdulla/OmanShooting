DATABASE_URL="postgresql://fadhil@localhost:5432/shooting"
SESSION_SECRET="change-me-to-a-long-random-string"   # e.g. openssl rand -hex 32
# Show OTP on screen in dev (no SMS provider configured)
OTP_DEV_ECHO="1"
# Leave empty to use the built-in mock gateway
THAWANI_SECRET_KEY=""
THAWANI_PUBLISHABLE_KEY=""
THAWANI_BASE_URL="https://uatcheckout.thawani.om"
APP_URL="http://localhost:3000"
# Demo conveniences (on-screen code, sandbox payments, banner) are ON unless DEMO_MODE="0"
DEMO_MODE="1"
CRON_SECRET=""
# Same sign-in code for everyone until an SMS provider is connected (default 123456 when unset; "off" = random codes)
FIXED_OTP="123456"

# Electronic invoices — seller details printed on every invoice
INVOICE_SELLER_NAME="Oman Committee for Traditional Shooting"
INVOICE_SELLER_NAME_AR="اللجنة العُمانية للرماية التقليدية"
INVOICE_SELLER_ADDRESS="Muscat, Sultanate of Oman"
INVOICE_SELLER_VATIN=""
INVOICE_SELLER_CR=""
# VAT in percent on entry fees (prices are VAT-inclusive). 0 = not subject to VAT; Oman's standard rate is 5.
INVOICE_VAT_RATE="0"
